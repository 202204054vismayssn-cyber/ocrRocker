OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=120.0
SAVVY_API_KEY=
ADMIN_API_KEY=
ENABLE_SELF_RESTART=false
RESTART_DELAY_SECONDS=2
LOG_LEVEL=INFO
MAX_CONCURRENT_EXTRACTIONS=4
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=40000000
PADDLE_DEVICE=gpu
PADDLE_LANG=en
PADDLE_MODEL_CACHE_DIR=.model_cache/paddle
PADDLE_ENABLE_MKLDNN=false
API_CPU_LIMIT=4.0
API_MEMORY_LIMIT=12g
AUTO_RELOAD=false
RELOAD_DELAY_SECONDS=5
